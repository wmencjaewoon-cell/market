{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "윈도우 Ollama",
      "options": {
        "baseURL": "http://192.168.0.198:11434/v1"
      },
      "models": {
        "qwen2.5-coder:14b": {
          "name": "Qwen2.5 Coder 14B"
        },
        "qwen3:30b": {
          "name": "Qwen3 30B"
        }
      }
    }
  },

  "agent": {
    "build": {
      "mode": "primary",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "ask",
        "task": "deny"
      }
    }
  }
}